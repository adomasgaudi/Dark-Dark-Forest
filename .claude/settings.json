{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/check-commit-msg.sh\"",
            "timeout": 10,
            "statusMessage": "Checking commit message format"
          }
        ]
      }
    ]
  }
}
